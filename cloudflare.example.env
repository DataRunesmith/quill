# Every __NAME__ placeholder used in the source is listed here. Copy this file
# to .cloudflare.env, fill in your own values and deploy with:
#   sh tools/deploy.sh .cloudflare.env
# Secrets (MAIL_CRED_KEY, RESEND_API_KEY, OAuth client secrets, ...) do not
# belong here; set them with `wrangler secret put` or in the container environment.
PUBLIC_HOST=letters.example.com
SYSTEM_FROM_ADDRESS=noreply@example.com
TURNSTILE_SITE_KEY=
TURNSTILE_HOSTNAMES=letters.example.com
D1_DATABASE_NAME=quill
D1_DATABASE_ID=00000000-0000-0000-0000-000000000000
KV_SESSIONS_ID=00000000000000000000000000000000
SYSTEM_SMTP_HOST=
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_USER=
FEEDBACK_NOTIFY_EMAIL=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_ID=
THEME_KEY_PREFIX=quill
THEME_COOKIE_DOMAIN=
SITE_FAMILY=Example
DONATION_HTML=
